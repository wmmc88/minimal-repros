;===================================================================
; Mixed TraceLogging Repro - WDM Driver
;===================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = Sample
ClassGuid   = {78A1C341-4539-11d3-B88D-00C04FAD5171}
Provider    = %ProviderString%
PnpLockDown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
wdm_driver.sys = 1,,

; ================= Class section =====================

[ClassInstall32]
Addreg=SampleClassReg

[SampleClassReg]
HKR,,,0,%ClassName%
HKR,,Icon,,-5

; ================= Install section =================

[Manufacturer]
%StdMfg%=Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceDesc%=MixedWDMDevice, root\MIXED_TRACELOGGING_WDM_HW_ID

[MixedWDMDevice.NT$ARCH$]
CopyFiles=Drivers_Dir

[Drivers_Dir]
wdm_driver.sys

; ================= Service installation =================
[MixedWDMDevice.NT$ARCH$.Services]
AddService = MixedWDMService, %SPSVCINST_ASSOCSERVICE%, Mixed_WDM_Service_Install

[Mixed_WDM_Service_Install]
DisplayName    = %ServiceDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\wdm_driver.sys

; ================= Strings =================
[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderString         = "MixedTraceLoggingRepro"
StdMfg                 = "(Standard system devices)"
DiskId1                = "Mixed TraceLogging WDM Installation Disk #1"
DeviceDesc             = "Mixed TraceLogging WDM Rust Device"
ServiceDesc            = "Mixed TraceLogging WDM Rust Service"
ClassName              = "Sample Device"
